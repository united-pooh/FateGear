# Shared provider settings
AGENT_API_KEY=
AGENT_BASE_URL=
AGENT_ORGANIZATION=
AGENT_PROJECT=

# DeepSeek shortcut. If AGENT_API_KEY / OPENAI_API_KEY are empty,
# DEEPSEEK_API_KEY automatically uses https://api.deepseek.com
# and defaults Planner/Narrator models to deepseek-v4-pro.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek V4 defaults to non-thinking mode for faster structured JSON calls.
# Set to enabled if you want deeper but slower Plan/Render responses.
DEEPSEEK_THINKING=disabled

# Planner Agent
PLANNER_AGENT_MODEL=
PLANNER_AGENT_TEMPERATURE=0.7
PLANNER_AGENT_TOP_P=1.0
PLANNER_AGENT_TOP_K=
PLANNER_AGENT_TIMEOUT_SECONDS=
PLANNER_AGENT_API_KEY=
PLANNER_AGENT_BASE_URL=
PLANNER_AGENT_ORGANIZATION=
PLANNER_AGENT_PROJECT=

# Narrator Agent
NARRATOR_AGENT_MODEL=
NARRATOR_AGENT_TEMPERATURE=0.9
NARRATOR_AGENT_TOP_P=1.0
NARRATOR_AGENT_TOP_K=
NARRATOR_AGENT_TIMEOUT_SECONDS=
NARRATOR_AGENT_API_KEY=
NARRATOR_AGENT_BASE_URL=
NARRATOR_AGENT_ORGANIZATION=
NARRATOR_AGENT_PROJECT=
