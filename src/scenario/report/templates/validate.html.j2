<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>KTSL Validate Report — {{ report.fixture_id }}</title>
<style>
  *, *::before, *::after { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans SC", "Helvetica Neue", Arial, sans-serif;
    background: #f5f6f8;
    color: #1f2933;
    line-height: 1.55;
  }
  .container { max-width: 960px; margin: 0 auto; padding: 0 20px 60px; }

  header.report-header {
    background: linear-gradient(135deg, #1f2933 0%, #2d3748 100%);
    color: #fff;
    padding: 28px 0 22px;
  }
  header.report-header h1 { margin: 0 0 4px; font-size: 24px; }
  header.report-header .meta { color: #cbd5e1; font-size: 13px; }
  header.report-header .meta span { margin-right: 16px; }

  .verdict {
    text-align: center;
    padding: 24px;
    border-radius: 8px;
    margin: 24px 0;
    font-size: 32px;
    font-weight: 800;
    color: #fff;
  }
  .verdict.pass { background: linear-gradient(135deg, #10b981 0%, #059669 100%); }
  .verdict.fail { background: linear-gradient(135deg, #ef4444 0%, #b91c1c 100%); }

  section { margin-top: 28px; }
  section h2 { border-bottom: 2px solid #e5e7eb; padding-bottom: 6px; }

  .issues-list { list-style: none; padding: 0; }
  .issues-list li {
    background: #fff;
    border-left: 4px solid #6b7280;
    padding: 10px 14px;
    margin-bottom: 6px;
    border-radius: 4px;
    box-shadow: 0 1px 2px rgba(0,0,0,.05);
  }
  .issues-list li.error { border-left-color: #ef4444; }
  .issues-list li.warning { border-left-color: #f59e0b; }
  .issues-list li.info { border-left-color: #3b82f6; }
  .issues-list .level-badge {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 3px;
    font-size: 11px;
    font-weight: 700;
    color: #fff;
    margin-right: 6px;
  }
  .level-badge.error { background: #ef4444; }
  .level-badge.warning { background: #f59e0b; }
  .level-badge.info { background: #3b82f6; }
  .issues-list code { background: #f3f4f6; padding: 1px 4px; border-radius: 3px; font-size: 12px; }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
    margin: 16px 0;
  }
  .stat-card {
    background: #fff;
    border-radius: 8px;
    padding: 14px;
    border-left: 4px solid #6b7280;
    box-shadow: 0 1px 3px rgba(0,0,0,.05);
    text-align: center;
  }
  .stat-card.error { border-left-color: #ef4444; }
  .stat-card.warning { border-left-color: #f59e0b; }
  .stat-card.info { border-left-color: #3b82f6; }
  .stat-card .stat-val { font-size: 28px; font-weight: 700; }
  .stat-card .stat-label { font-size: 12px; color: #6b7280; text-transform: uppercase; }

  .exit-code {
    background: #fff;
    padding: 12px 18px;
    border-radius: 8px;
    margin-top: 16px;
    font-family: ui-monospace, "SF Mono", Menlo, Monaco, Consolas, monospace;
    font-size: 14px;
    box-shadow: 0 1px 3px rgba(0,0,0,.05);
  }
  .exit-code strong { color: #1f2933; }

  footer.report-footer {
    margin-top: 40px;
    padding-top: 16px;
    border-top: 1px solid #e5e7eb;
    color: #6b7280;
    font-size: 12px;
    text-align: center;
  }
</style>
</head>
<body>

<header class="report-header">
  <div class="container">
    <h1>KTSL Validate Report</h1>
    <div class="meta">
      <span><strong>Fixture:</strong> {{ report.fixture_id }}</span>
      {% if report.fixture_title %}<span><strong>Title:</strong> {{ report.fixture_title }}</span>{% endif %}
      <span><strong>Validated at:</strong> {{ report.validated_at }}</span>
    </div>
  </div>
</header>

<div class="container">

  <!-- Verdict -->
  <div class="verdict {{ "pass" if report.is_valid else "fail" }}">
    {{ "✅ PASS" if report.is_valid else "❌ FAIL" }}
  </div>

  <!-- Issue counts -->
  <div class="stats-grid">
    <div class="stat-card error">
      <div class="stat-val">{{ error_count }}</div>
      <div class="stat-label">Errors</div>
    </div>
    <div class="stat-card warning">
      <div class="stat-val">{{ warning_count }}</div>
      <div class="stat-label">Warnings</div>
    </div>
    <div class="stat-card info">
      <div class="stat-val">{{ info_count }}</div>
      <div class="stat-label">Infos</div>
    </div>
  </div>

  <!-- Issues list -->
  <section id="issues">
    <h2>Issues</h2>
    {% if report.issues %}
    <ul class="issues-list">
      {% for issue in report.issues %}
      <li class="{{ issue.level }}">
        <span class="level-badge {{ issue.level }}">{{ issue.level|upper }}</span>
        <code>{{ issue.code }}</code>: {{ issue.message }}
        {% if issue.resource_id %}<br><small style="color: #6b7280;">Resource: <code>{{ issue.resource_id }}</code></small>{% endif %}
      </li>
      {% endfor %}
    </ul>
    {% else %}
    <p>_No issues found. Fixture is structurally valid._</p>
    {% endif %}
  </section>

  <!-- Exit code info -->
  <div class="exit-code">
    <strong>Exit code:</strong> <code>{{ exit_code }}</code>
    <br><small>
      0 = all passed · 1 = warnings only · 2 = at least one error
    </small>
  </div>

</div>

<footer class="report-footer">
  Generated by KTSL toolchain · {{ now }}
</footer>

</body>
</html>
